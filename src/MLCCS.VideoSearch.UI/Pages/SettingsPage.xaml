<Page x:Class="MLCCS.VideoSearch.UI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="20" ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="12">
      <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" Margin="8,0,0,4"/>
      <ListView x:Name="CategoryList" SelectionChanged="CategoryList_SelectionChanged" SelectedIndex="0"
                SelectionMode="Single" AutomationProperties.Name="设置类别">
        <ListViewItem Content="常规与启动" Tag="general"/>
        <ListViewItem Content="资源库" Tag="libraries"/>
        <ListViewItem Content="索引内容" Tag="index"/>
        <ListViewItem Content="模型与质量" Tag="models"/>
        <ListViewItem Content="性能与后台" Tag="performance"/>
        <ListViewItem Content="搜索与隐私" Tag="search"/>
        <ListViewItem Content="存储管理" Tag="storage"/>
        <ListViewItem Content="更新与诊断" Tag="diagnostics"/>
        <ListViewItem Content="关于" Tag="about"/>
      </ListView>
    </StackPanel>
    <Grid Grid.Column="1">
      <ScrollViewer x:Name="GeneralPanel">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
          <TextBlock Text="常规与启动" Style="{StaticResource TitleTextBlockStyle}"/>
          <Border Style="{StaticResource CardBorderStyle}" Padding="18">
            <StackPanel Spacing="14">
              <ToggleSwitch x:Name="AutoStartToggle" Header="启动后自动继续索引" IsOn="True"/>
              <ToggleSwitch x:Name="AutoIndexNewFilesToggle"
                            Header="自动索引新文件"
                            OffContent="资源库变化时不自动扫描"
                            OnContent="检测到新增或修改的视频后自动索引"
                            IsOn="True"/>
              <ToggleSwitch Header="关闭窗口后保持 Agent 运行" IsOn="True" IsEnabled="False"/>
              <TextBlock Text="长期工作由托盘 Agent 管理。关闭主窗口不会取消索引或搜索服务。" TextWrapping="Wrap" Opacity="0.7"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="LibrariesPanel" Visibility="Collapsed">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="16">
          <TextBlock Text="资源库" Style="{StaticResource TitleTextBlockStyle}"/>
          <TextBlock Text="每个资源库独立扫描；离线磁盘会标记为不可用，不会误删索引。" TextWrapping="Wrap"/>
          <ListView x:Name="LibrariesList" MinHeight="180" SelectionMode="Single"
                    SelectionChanged="LibrariesList_SelectionChanged"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="添加文件夹" Click="AddLibrary_Click"/>
            <Button x:Name="RemoveLibraryButton" Content="移除所选" Click="RemoveLibrary_Click"
                    IsEnabled="False"/>
            <Button Content="重新扫描全部" Click="Rescan_Click"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="IndexPanel" Visibility="Collapsed">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
          <TextBlock Text="索引内容" Style="{StaticResource TitleTextBlockStyle}"/>
          <Border Style="{StaticResource CardBorderStyle}" Padding="18">
            <StackPanel Spacing="14">
              <CheckBox x:Name="FilenameCheck" Content="文件名与基础信息" IsChecked="True"/>
              <CheckBox x:Name="VisualCheck" Content="视频画面与时间点预览" IsChecked="True"/>
              <CheckBox x:Name="SpeechCheck" Content="语音与逐词时间戳（需要 CUDA 和已验证模型）"/>
              <CheckBox x:Name="OcrCheck" Content="画面文字与字幕区域 OCR"/>
              <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
                <TextBlock Text="语音索引需要受支持的 CUDA；缺失模型时会明确提示下载，不会伪装完成。"
                           TextWrapping="Wrap" Opacity="0.76"/>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="ModelsPanel" Visibility="Collapsed">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
          <TextBlock Text="模型与质量" Style="{StaticResource TitleTextBlockStyle}"/>
          <Border Style="{StaticResource CardBorderStyle}" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Text="语音识别质量" FontWeight="SemiBold"/>
              <RadioButton x:Name="SpeechEconomyRadio" GroupName="SpeechModel" Content="经济 — Whisper small，速度和空间优先"/>
              <RadioButton x:Name="SpeechRecommendedRadio" GroupName="SpeechModel" Content="推荐 — Whisper medium，平衡中文准确率与资源" IsChecked="True"/>
              <RadioButton x:Name="SpeechHighRadio" GroupName="SpeechModel" Content="高质量 — Whisper large-v3，下载和显存占用较高"/>
              <TextBlock Text="系统会依据每台机器的 CUDA、显存与内存给出建议；选择不会写死并发或批大小。" TextWrapping="Wrap" Opacity="0.72"/>
              <Button Content="下载/校验所选模型" HorizontalAlignment="Left" Click="DownloadModels_Click"/>
              <TextBlock x:Name="ModelStatusText" TextWrapping="Wrap" Opacity="0.72"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="PerformancePanel" Visibility="Collapsed">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
          <TextBlock Text="性能与后台" Style="{StaticResource TitleTextBlockStyle}"/>
          <Border Style="{StaticResource CardBorderStyle}" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Text="资源策略" FontWeight="SemiBold"/>
              <RadioButton x:Name="EfficiencyRadio" GroupName="ResourcePolicy" Content="节省资源 — 降低并发，适合电池供电"/>
              <RadioButton x:Name="BalancedRadio" GroupName="ResourcePolicy" Content="推荐 — 根据温度、磁盘和显存动态调整"/>
              <RadioButton x:Name="FullRadio" GroupName="ResourcePolicy" Content="全速 — 使用当前机器可安全提供的 CPU/CUDA 资源" IsChecked="True"/>
              <TextBlock Text="解码器数量、Torch 线程和推理批大小在每台机器上重新探测。这里不会保存本机专用硬件数值。" TextWrapping="Wrap" Opacity="0.72"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="SearchPanel" Visibility="Collapsed">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
          <TextBlock Text="搜索与隐私" Style="{StaticResource TitleTextBlockStyle}"/>
          <Border Style="{StaticResource CardBorderStyle}" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Text="中文音近扩展" FontWeight="SemiBold"/>
              <RadioButton x:Name="PhoneticOff" GroupName="Phonetic" Content="关闭"/>
              <RadioButton x:Name="PhoneticLow" GroupName="Phonetic" Content="低"/>
              <RadioButton x:Name="PhoneticMedium" GroupName="Phonetic" Content="中（推荐）" IsChecked="True"/>
              <RadioButton x:Name="PhoneticHigh" GroupName="Phonetic" Content="高"/>
              <ToggleSwitch x:Name="HelpImproveToggle" Header="帮助 MLCCS 改进" IsOn="True"/>
              <TextBlock Text="仅允许不包含路径、媒体、查询、转写或 OCR 正文的低频匿名事件。完整日志每次上传前都必须预览并明确同意。" TextWrapping="Wrap" Opacity="0.72"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="DiagnosticsPanel" Visibility="Collapsed">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
          <TextBlock Text="更新与诊断" Style="{StaticResource TitleTextBlockStyle}"/>
          <Border Style="{StaticResource CardBorderStyle}" Padding="18">
            <StackPanel Spacing="14">
              <ToggleSwitch x:Name="AutomaticUpdatesToggle" Header="自动检查更新" IsOn="True"/>
              <Button Content="打开本地状态与日志目录" HorizontalAlignment="Left" Click="OpenLogs_Click"/>
              <TextBlock Text="更新只负责检测，不会静默安装或重启。诊断上传必须由你逐次确认。" TextWrapping="Wrap" Opacity="0.72"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="StoragePanel" Visibility="Collapsed">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="16">
          <TextBlock Text="存储管理" Style="{StaticResource TitleTextBlockStyle}"/>
          <TextBlock x:Name="StorageTotalText" Text="正在计算实际占用…" FontSize="18" FontWeight="SemiBold"/>
          <ItemsControl x:Name="StorageCategoryList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Padding="8,6" ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}"/>
                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="可安全清理的模型" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/>
          <TextBlock Text="只列出当前未使用或已由应用内版本替代的本地模型。删除后如再次启用，可按锁定清单重新下载。"
                     TextWrapping="Wrap" Opacity="0.72"/>
          <ListView x:Name="StorageCleanupList" SelectionMode="Multiple" MinHeight="120">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Padding="4,6" Spacing="3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.68"/>
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="删除所选可清理内容" Click="DeleteStorage_Click"/>
            <Button Content="重新计算" Click="RefreshStorage_Click"/>
          </StackPanel>
          <TextBlock x:Name="StorageStatusText" TextWrapping="Wrap" Opacity="0.72"/>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
          <TextBlock Text="关于" Style="{StaticResource TitleTextBlockStyle}"/>
          <TextBlock Text="MLCCS Video Search 0.3.0-feedback5" FontSize="20"/>
          <TextBlock Text="协议 1.0 · 本地优先 · Windows x64" Opacity="0.72"/>
        </StackPanel>
      </ScrollViewer>
      <TextBlock x:Name="SaveStatus" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,12,12" Opacity="0.7"/>
    </Grid>
  </Grid>
</Page>
