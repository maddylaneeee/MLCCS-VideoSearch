<Page x:Class="MLCCS.VideoSearch.UI.Pages.LibraryPage"
      x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="28,20,28,28" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <TextBlock Text="资源库" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock x:Name="SummaryText" Text="尚未添加资源库" Opacity="0.7"/>
      </StackPanel>
      <CommandBar Grid.Column="1" DefaultLabelPosition="Right" IsOpen="False">
        <AppBarButton Icon="Add" Label="添加文件夹" Click="AddFolder_Click"
                      AutomationProperties.Name="添加资源库文件夹"/>
        <AppBarButton Icon="Refresh" Label="重新扫描" Click="Rescan_Click"
                      AutomationProperties.Name="重新扫描全部资源库"/>
        <AppBarSeparator/>
        <AppBarToggleButton x:Name="GridModeButton" Icon="View" Label="网格" IsChecked="True"
                            Click="GridMode_Click"/>
        <AppBarToggleButton x:Name="ListModeButton" Icon="List" Label="列表" Click="ListMode_Click"/>
      </CommandBar>
    </Grid>
    <Expander Grid.Row="1" Margin="0,2,0,0">
      <Expander.Header>
        <TextBlock x:Name="LibrariesHeader" Text="已添加的文件夹"/>
      </Expander.Header>
      <StackPanel Spacing="8" Padding="0,8,0,4">
        <TextBlock Text="移除只会取消资源库关联并清除对应索引，不会删除磁盘上的文件。"
                   TextWrapping="Wrap" Opacity="0.68"/>
        <ItemsControl ItemsSource="{x:Bind Libraries, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Padding="8,5" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                <Button Grid.Column="1" Content="移除" Tag="{Binding}"
                        Click="RemoveFolder_Click"
                        AutomationProperties.Name="从资源库移除此文件夹"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Expander>
    <Grid Grid.Row="2">
      <TextBlock x:Name="LibraryStateText" Text="资源库文件独立显示；索引状态请前往“索引任务”。"
                 TextWrapping="Wrap" Opacity="0.72" VerticalAlignment="Center"/>
      <InfoBar x:Name="LibraryStatus" IsOpen="False" Severity="Error"/>
    </Grid>
    <Grid Grid.Row="3">
      <GridView x:Name="AssetGrid" ItemsSource="{x:Bind Items, Mode=OneWay}"
                IsItemClickEnabled="True" ItemClick="Asset_ItemClick" DoubleTapped="Asset_DoubleTapped"
                ContainerContentChanging="Asset_ContainerContentChanging"
                SelectionMode="Single" AutomationProperties.Name="资源库网格">
        <GridView.ItemsPanel>
          <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0"/></ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemTemplate>
          <DataTemplate>
            <Grid Width="260" MinHeight="244" Padding="8" RowSpacing="7">
              <Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <Grid>
                  <FontIcon Glyph="&#xE8B2;" FontSize="28" Opacity="0.35"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                </Grid>
              </Border>
              <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="2" Text="{Binding MetadataText}" Opacity="0.72" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Row="3" Text="{Binding Status}" Opacity="0.72" Margin="0,0,0,4"/>
            </Grid>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>
      <ListView x:Name="AssetList" ItemsSource="{x:Bind Items, Mode=OneWay}" Visibility="Collapsed"
                IsItemClickEnabled="True" ItemClick="Asset_ItemClick" DoubleTapped="Asset_DoubleTapped"
                ContainerContentChanging="Asset_ContainerContentChanging"
                SelectionMode="Single" AutomationProperties.Name="资源库列表">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid MinHeight="104" Padding="4" ColumnSpacing="14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="160" Height="90" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="7">
                <Grid>
                  <FontIcon Glyph="&#xE8B2;" FontSize="24" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding MetadataText}" Opacity="0.72"/>
                <TextBlock Text="{Binding Library}" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" Margin="16"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Grid>
</Page>
