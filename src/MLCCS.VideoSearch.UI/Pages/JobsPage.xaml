<Page x:Class="MLCCS.VideoSearch.UI.Pages.JobsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Padding="28,20,28,28" Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
      <TextBlock Text="索引任务" Style="{StaticResource TitleTextBlockStyle}"/>
      <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error"/>
      <Border Style="{StaticResource CardBorderStyle}" Padding="16">
        <StackPanel Spacing="5">
          <TextBlock x:Name="StatusTitleText" Text="正在连接 Agent" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="StatusMessageText" Text="正在读取真实任务状态。" TextWrapping="Wrap" Opacity="0.72"/>
        </StackPanel>
      </Border>
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ProgressBar x:Name="RealProgress" Value="0" Maximum="100" Height="8" VerticalAlignment="Center"/>
        <TextBlock x:Name="ProgressText" Grid.Column="1" Text="0.0%" MinWidth="64"
                   FontWeight="SemiBold" HorizontalTextAlignment="Right"/>
      </Grid>
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardBorderStyle}" Padding="16">
          <StackPanel><TextBlock Text="已完成工作" Opacity="0.7"/><TextBlock x:Name="CompletedText" Text="0" FontSize="28" FontWeight="SemiBold"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
          <StackPanel><TextBlock Text="失败文件" Opacity="0.7"/><TextBlock x:Name="FailedText" Text="0" FontSize="28" FontWeight="SemiBold"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
          <StackPanel><TextBlock Text="预计剩余" Opacity="0.7"/><TextBlock x:Name="EtaText" Text="—" FontSize="28" FontWeight="SemiBold"/></StackPanel>
        </Border>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click"/>
        <Button x:Name="CancelButton" Content="取消当前任务" Click="Cancel_Click"/>
        <Button Content="重新扫描全部" Click="Rescan_Click"/>
        <Button Content="打开状态目录" Click="OpenStatus_Click"/>
      </StackPanel>
      <Border Style="{StaticResource CardBorderStyle}" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock x:Name="CurrentFileStatus" Text="当前文件：—" TextWrapping="Wrap"/>
          <TextBlock x:Name="HardwareStatus" Text="硬件：等待检测" TextWrapping="Wrap"/>
          <TextBlock x:Name="ThroughputStatus" Text="处理速度：等待采样" TextWrapping="Wrap"/>
          <TextBlock x:Name="ModelDownloadStatus" Text="模型：标准视觉模型已随应用提供" TextWrapping="Wrap"/>
          <TextBlock Text="索引会根据这台电脑的性能自动控制资源占用。" TextWrapping="Wrap" Opacity="0.72"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
