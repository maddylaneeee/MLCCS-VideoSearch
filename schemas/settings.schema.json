{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lixinchen.ca/schemas/mlccs-videosearch/settings-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "libraries", "autoStart", "autoIndexNewFiles", "intervalSeconds",
    "batchSize", "decoderWorkers", "resourcePolicy", "filename", "visual", "speech", "ocr",
    "speechModel", "automaticUpdates", "skippedVersion", "phoneticExpansion", "searchModelIdleMinutes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "libraries": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "autoStart": { "type": "boolean" },
    "autoIndexNewFiles": { "type": "boolean" },
    "intervalSeconds": { "type": "number", "minimum": 2, "maximum": 8 },
    "batchSize": { "type": "integer", "minimum": 0 },
    "decoderWorkers": { "type": "integer", "minimum": 0 },
    "resourcePolicy": { "enum": ["adaptive-full", "balanced", "efficiency"] },
    "filename": { "const": true },
    "visual": { "const": true },
    "speech": { "type": "boolean" },
    "ocr": { "type": "boolean" },
    "speechModel": { "enum": ["whisper-tiny", "whisper-base", "whisper-small", "whisper-medium", "whisper-large-v3-turbo", "whisper-large-v3"] },
    "automaticUpdates": { "type": "boolean" },
    "skippedVersion": { "type": ["string", "null"] },
    "phoneticExpansion": { "enum": ["off", "low", "medium", "high"] },
    "searchModelIdleMinutes": { "enum": [5, 10, 30] }
  }
}
