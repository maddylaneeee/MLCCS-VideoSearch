{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lixinchen.ca/schemas/mlccs-videosearch/release-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productVersion", "minimumCompatibleVersion", "requirements", "entryPoint", "publishedUtc", "releaseNotes", "mandatory", "components", "keyId", "manifestSignature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productVersion": { "const": "1.0.0" },
    "minimumCompatibleVersion": { "type": "string" },
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["minimumWindowsVersion", "minimumWindowsBuild", "architecture", "gpuVendor", "minimumVramBytes", "cudaRuntime", "cudaToolkitRequired"],
      "properties": {
        "minimumWindowsVersion": { "const": "Windows 10 1809" },
        "minimumWindowsBuild": { "const": 17763 },
        "architecture": { "const": "x64" },
        "gpuVendor": { "const": "NVIDIA" },
        "minimumVramBytes": { "minimum": 4026531840 },
        "cudaRuntime": { "const": "PyTorch 2.7.1+cu128" },
        "cudaToolkitRequired": { "const": false }
      }
    },
    "entryPoint": { "const": "current/ui/MLCCS.VideoSearch.UI.exe" },
    "publishedUtc": { "type": "string", "format": "date-time" },
    "releaseNotes": { "type": "string", "maxLength": 20000 },
    "mandatory": { "type": "boolean" },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
    "keyId": { "type": "string", "minLength": 8 },
    "manifestSignature": { "type": "string", "contentEncoding": "base64" }
  },
  "$defs": {
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "size", "sha256"], "properties": {
      "path": { "type": "string", "minLength": 1 }, "size": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }},
    "component": { "type": "object", "additionalProperties": false,
      "required": ["id", "name", "description", "url", "installScope", "required", "defaultSelected", "size", "sha256", "files"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "name": { "type": "string" }, "description": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" },
        "installScope": { "enum": ["current", "runtime", "qdrant", "visual-model", "text-model", "ocr-models"] },
        "required": { "type": "boolean" }, "defaultSelected": { "type": "boolean" },
        "size": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
      }
    }
  }
}
